root = true

[*]
charset              = utf-8
end_of_line          = lf
indent_size          = 4
indent_style         = space
insert_final_newline = true
max_line_length      = 120
tab_width            = 4

[*.rs]
max_line_length = 120

[*.{json,css}]
indent_size = 2

[*.scd]
indent_style = tab

[Makefile]
indent_style    = tab
max_line_length = off
